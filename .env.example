# Connection string for PostgreSQL - Prisma and the application read this
DATABASE_URL="postgresql://user:password@localhost:5432/ecommerce?schema=public"

# Port the Express server listens on (default: 3000)
PORT=3000

# Environment mode: "development" | "production" | "test" (default: development)
NODE_ENV=development

# Number of reverse-proxy hops in front of the app (integer 0-5, default: 1).
# Express derives req.ip by walking that many hops back from the app, starting
# at the socket peer and moving left through the X-Forwarded-For header.
#
# req.ip is what the rate limiter keys on UNLESS CLIENT_IP_HEADER is set, and
# it is always what Express itself uses for req.ip / req.ips.
#
# Set it to the number of entries the platform's proxy chain actually produces.
# Too few hops -> the budget is charged to a proxy node instead of the visitor.
# Too many  -> the caller controls the leftmost entry and can rotate it to
#              reset the budget.
# See DEPLOY.md "Step 9: Rate Limit & Security Verification".
TRUST_PROXY_HOPS=1

# Optional: name of the HTTP header that carries the client's real IP, set by
# the hosting platform's edge proxy. When set, the rate limiter keys on that
# header's value instead of on Express's req.ip, which makes the limiter
# independent of how many proxy hops the request crossed.
#
# The value is validated strictly: it must be a single, trimmed, <= 45
# character string that passes net.isIP(). A missing, empty, oversized,
# comma-separated or non-IP value falls back to req.ip.
#
# The name is checked against an allowlist, so only headers that a trusted edge
# proxy is known to set can be selected. Currently "x-real-ip" only.
#
# Leave this EMPTY for local development and for platforms with a documented,
# stable proxy chain (use TRUST_PROXY_HOPS there). See README.md
# "Rate Limiting" and DEPLOY.md "Step 9".
CLIENT_IP_HEADER=

# Diagnostic (default false). When true, the app logs the raw X-Real-IP header
# it receives, so you can confirm that the platform's edge REPLACES the header
# (safe to key the limiter on) instead of APPENDING to it (not safe).
#
# At most 10 distinct values are logged per process, each truncated to 100
# characters. Only that header and req.ip are ever printed.
#
# Switch it on for the verification run and switch it off again afterwards.
LOG_CLIENT_IP_HEADER=false
